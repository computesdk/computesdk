{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "computesdk-cloudflare-direct-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "SANDBOX",
        "class_name": "Sandbox",
