{
  "name": "@computesdk/boxd",
  "version": "0.1.0",
  "description": "boxd provider for ComputeSDK - isolated Linux computers on their own microVMs that boot in milliseconds, with snapshots and HTTPS URLs for any port",
  "author": "boxd",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint"
  },
  "keywords": [
    "computesdk",
    "provider",
    "sandbox",
    "code-execution",
    "cloud",
    "compute",
    "boxd",
    "microvm"
  ],
  "dependencies": {
    "@boxd-sh/sdk": "^0.3.0",
    "@bufbuild/protobuf": "^2.10.2",
    "@computesdk/provider": "workspace:*",
    "@grpc/grpc-js": "^1.12.0",
    "computesdk": "workspace:*"
  },
  "devDependencies": {
    "@computesdk/test-utils": "workspace:*",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.37.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/computesdk/computesdk.git",
    "directory": "packages/boxd"
  },
  "homepage": "https://boxd.sh",
  "bugs": {
    "url": "https://github.com/computesdk/computesdk/issues"
  }
}
