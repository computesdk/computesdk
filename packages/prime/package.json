{
  "name": "@computesdk/prime",
  "version": "0.1.0",
  "description": "Prime Intellect provider for ComputeSDK",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-web": "^2.1.2",
    "@computesdk/provider": "workspace:*",
    "computesdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "@computesdk/test-utils": "workspace:*",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.37.0"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Prime Intellect",
  "keywords": [
    "computesdk",
    "provider",
    "sandbox",
    "prime-intellect",
    "microvm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/computesdk/computesdk.git",
    "directory": "packages/prime"
  },
  "homepage": "https://www.primeintellect.ai",
  "bugs": {
    "url": "https://github.com/computesdk/computesdk/issues"
  }
}
