{
  "name": "@computesdk/createos-sandbox",
  "version": "0.1.35",
  "description": "CreateOS sandbox adapter for ComputeSDK. Run code in NodeOps VMs with pause, resume, and fork support.",
  "author": "NodeOps Inc.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint"
  },
  "dependencies": {
    "@computesdk/provider": "workspace:*",
    "@nodeops-createos/sandbox": "^0.8.5"
  },
  "keywords": [
    "code-execution",
    "computesdk",
    "createos",
    "createos-sandbox",
    "nodeops",
    "provider",
    "sandbox",
    "snapshot"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/computesdk/computesdk.git",
    "directory": "packages/createos-sandbox"
  },
  "homepage": "https://github.com/computesdk/computesdk/tree/main/packages/createos-sandbox#readme",
  "bugs": {
    "url": "https://github.com/computesdk/computesdk/issues"
  },
  "devDependencies": {
    "@computesdk/test-utils": "workspace:*",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "computesdk": "workspace:*",
    "eslint": "^8.37.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
