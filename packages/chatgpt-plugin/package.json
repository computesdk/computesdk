{
  "name": "@computesdk/chatgpt-plugin",
  "version": "0.1.0",
  "description": "ComputeSDK — developer tool for running code in any sandbox provider, with live market bidding for the best price. ChatGPT plugin (MCP server).",
  "author": "ComputeSDK",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "computesdk-chatgpt": "./dist/index.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint"
  },
  "dependencies": {
    "@computesdk/archil": "workspace:*",
    "@computesdk/blaxel": "workspace:*",
    "@computesdk/namespace": "workspace:*",
    "@computesdk/provider": "workspace:*",
    "@computesdk/tensorlake": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.24.0",
    "computesdk": "workspace:*",
    "zod": "^4.4.3"
  },
  "keywords": [
    "computesdk",
    "chatgpt",
    "plugin",
    "mcp",
    "sandbox",
    "code-execution"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/computesdk/computesdk.git",
    "directory": "packages/chatgpt-plugin"
  },
  "homepage": "https://www.computesdk.com",
  "bugs": {
    "url": "https://github.com/computesdk/computesdk/issues"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^8.37.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
