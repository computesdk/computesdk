{
  "name": "@computesdk/cli",
  "version": "2.6.4",
  "description": "ComputeSDK CLI - Cloud-native workspace management",
  "author": "ComputeSDK",
  "license": "MIT",
  "type": "module",
  "bin": {
    "compute": "./dist/index.js"
  },
  "files": [
    "dist",
    "bootstrap.sh",
    "cli-manifest.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "manifest": "tsup && node dist/index.js __manifest > cli-manifest.json",
    "pretest": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint"
  },
  "keywords": [
    "compute",
    "cli",
    "workspace",
    "sandbox",
    "cloud",
    "computesdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/computesdk/computesdk.git"
  },
  "homepage": "https://www.computesdk.com",
  "bugs": {
    "url": "https://github.com/computesdk/computesdk/issues"
  },
  "dependencies": {
    "@benchsdk/cli": "^0.9.5",
    "@benchsdk/runner": "^0.8.6",
    "@clack/prompts": "^0.7.0",
    "@computesdk/platform": "workspace:*",
    "commander": "^11.1.0",
    "computesdk": "workspace:*",
    "picocolors": "^1.0.0",
    "tar": "^7.4.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.37.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}