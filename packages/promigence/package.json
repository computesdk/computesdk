{
  "name": "@computesdk/promigence",
  "version": "1.0.17",
  "description": "Promigence sandbox adapter for ComputeSDK. Run agent code with streaming command output and filesystem access.",
  "author": "Promigence AI, Inc. <support@promigence.ai>",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint"
  },
  "keywords": [
    "computesdk",
    "promigence",
    "provider",
    "sandbox",
    "code-execution",
    "agents",
    "snapshot",
    "cloud",
    "compute"
  ],
  "dependencies": {
    "@computesdk/provider": "workspace:*",
    "@promigence/sdk": "0.1.0-beta.25",
    "computesdk": "workspace:*"
  },
  "devDependencies": {
    "@computesdk/test-utils": "workspace:*",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.37.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/computesdk/computesdk.git",
    "directory": "packages/promigence"
  },
  "homepage": "https://github.com/computesdk/computesdk/tree/main/packages/promigence#readme",
  "bugs": {
    "url": "https://github.com/computesdk/computesdk/issues"
  }
}
