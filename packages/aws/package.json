{
  "name": "@computesdk/aws",
  "version": "1.0.8",
  "description": "AWS providers for ComputeSDK. @computesdk/aws/ec2: on-demand or Spot EC2 instances, commands over SSM Run Command. @computesdk/aws/agentcore: Bedrock AgentCore Code Interpreter sessions",
  "author": "Garrison",
  "license": "MIT",
  "exports": {
    "./agentcore": {
      "types": "./dist/agentcore/index.d.ts",
      "import": "./dist/agentcore/index.mjs",
      "require": "./dist/agentcore/index.js"
    },
    "./ec2": {
      "types": "./dist/ec2/index.d.ts",
      "import": "./dist/ec2/index.mjs",
      "require": "./dist/ec2/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "agentcore": [
        "./dist/agentcore/index.d.ts"
      ],
      "ec2": [
        "./dist/ec2/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "3.1078.0",
    "@aws-sdk/client-ec2": "3.1078.0",
    "@aws-sdk/client-s3": "3.1078.0",
    "@aws-sdk/client-ssm": "3.1078.0",
    "@aws-sdk/types": "3.973.15",
    "@computesdk/provider": "workspace:*",
    "computesdk": "workspace:*"
  },
  "devDependencies": {
    "@computesdk/test-utils": "workspace:*",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "aws-sdk-client-mock": "4.1.0",
    "eslint": "^8.37.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "computesdk",
    "aws",
    "ec2",
    "spot",
    "ssm",
    "agentcore",
    "bedrock",
    "code-interpreter",
    "sandbox",
    "code-execution",
    "cloud",
    "provider"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/computesdk/computesdk.git",
    "directory": "packages/aws"
  },
  "homepage": "https://www.computesdk.com",
  "bugs": {
    "url": "https://github.com/computesdk/computesdk/issues"
  }
}
