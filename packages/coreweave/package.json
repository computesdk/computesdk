{
  "name": "@computesdk/coreweave",
  "version": "1.0.0",
  "description": "CoreWeave Sandboxes provider for ComputeSDK - container sandboxes on CoreWeave serverless or CKS capacity",
  "author": "ComputeSDK",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint"
  },
  "keywords": [
    "computesdk",
    "provider",
    "sandbox",
    "code-execution",
    "cloud",
    "compute",
    "coreweave",
    "cwsandbox"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@computesdk/provider": "workspace:*",
    "@coreweave/cwsandbox": "^1.1.0",
    "computesdk": "workspace:*"
  },
  "devDependencies": {
    "@computesdk/test-utils": "workspace:*",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.37.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/computesdk/computesdk.git",
    "directory": "packages/coreweave"
  },
  "homepage": "https://docs.coreweave.com/products/sandboxes",
  "bugs": {
    "url": "https://github.com/computesdk/computesdk/issues"
  }
}
